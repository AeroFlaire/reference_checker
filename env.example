# Required: your email for OpenAlex / Crossref polite-pool access.
# Without this, OpenAlex still works but at slower rate limits.
OPENALEX_EMAIL=arjo456@gmail.com

# Optional: a Semantic Scholar API key (lifts the 100-req/5min free tier limit).
# Leave blank if you don't have one.
S2_API_KEY=g24qmH5WI25wTKLHJJH1SDYkP3rkkpz8AtccLrVi

# Optional: enable a local Ollama LLM as a final fallback for refs that fail
# every other check. Default off — editors don't need to install Ollama.
USE_OLLAMA_FALLBACK=false
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3

# Optional: tune concurrency
# MAX_REF_WORKERS=6
# BATCH_PDF_WORKERS=2
